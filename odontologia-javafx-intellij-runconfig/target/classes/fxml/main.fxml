<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clinica.controllers.MainController">
    <children>
        <TabPane fx:id="tabPane" prefWidth="980" prefHeight="620">
            <tabs>
                <Tab text="Odontólogos">
                    <content>
                        <fx:include source="odontologo-view.fxml" />
                    </content>
                </Tab>
                <Tab text="Pacientes">
                    <content>
                        <fx:include source="paciente-view.fxml" />
                    </content>
                </Tab>
                <Tab text="Citas">
                    <content>
                        <fx:include source="cita-view.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
