    <?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.odontologia.ui.DashboardController">
  <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
  <Label text="Dashboard" style="-fx-font-size:18px;"/>
  <HBox spacing="10">
    <Button text="Pacientes" onAction="#onOpenPacientes"/>
    <Button text="Médicos" onAction="#onOpenMedicos"/>
    <Button text="Citas" onAction="#onOpenCitas"/>
  </HBox>
  <Label fx:id="messageLabel"/>
</VBox>
