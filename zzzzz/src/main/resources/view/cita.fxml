    <?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.DatePicker?>
<VBox spacing="8" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.odontologia.ui.CitaController">
  <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
  <Label text="Agendar Cita" style="-fx-font-size:16px;"/>
  <TextField fx:id="pacienteDni" promptText="DNI Paciente"/>
  <TextField fx:id="pacienteNombre" promptText="Nombre Paciente (si nuevo)"/>
  <TextField fx:id="medicoDni" promptText="DNI Médico"/>
  <DatePicker fx:id="fechaPicker"/>
  <TextField fx:id="horaField" promptText="Hora (HH:MM)"/>
  <TextField fx:id="motivoField" promptText="Motivo"/>
  <Button text="Agendar" onAction="#onAgendar"/>
  <Label fx:id="messageLabel"/>
</VBox>
