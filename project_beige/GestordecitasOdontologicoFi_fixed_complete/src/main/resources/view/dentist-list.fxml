<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="pe.edu.upeu.GestorOdontologico.controller.DentistController">
    <children>
        <VBox spacing="8" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <Label text="Lista de Odontólogos" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <HBox spacing="8">
                <TextField fx:id="txtSearch" promptText="Buscar por apellido..."/>
                <Button text="Buscar" onAction="#searchByLastName"/>
                <Button text="Actualizar" onAction="#loadDentists"/>
            </HBox>

            <TableView fx:id="tblDentists" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombres" text="Nombres" prefWidth="120"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="120"/>
                    <TableColumn fx:id="colColegiado" text="Colegiado" prefWidth="100"/>
                    <TableColumn fx:id="colEspecialidad" text="Especialidad" prefWidth="120"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox spacing="8">
                <Button text="Nuevo Odontólogo" onAction="#openDentistForm"/>
                <Button text="Ver Odontólogos" onAction="#openDentistList"/>
                <Button text="Editar" onAction="#openEdit"/>
                <Button text="Eliminar" onAction="#deleteSelected"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
