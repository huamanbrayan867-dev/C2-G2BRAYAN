<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.GestorOdontologico.controller.RegistrarCitaController" stylesheets="@../css/dark-blue-modern.css">

    <Label text="Registrar Cita" style="-fx-font-size: 16px; -fx-font-weight: bold"/>

    <ComboBox fx:id="pacienteCombo" promptText="Seleccionar Paciente"/>
    <ComboBox fx:id="odontologoCombo" promptText="Seleccionar Odontólogo"/>
    <DatePicker fx:id="fechaPicker"/>
    <TextField fx:id="horaField" promptText="Hora (ej: 10:30)"/>

    <Button text="Registrar" onAction="#registrarCita"/>
</VBox>