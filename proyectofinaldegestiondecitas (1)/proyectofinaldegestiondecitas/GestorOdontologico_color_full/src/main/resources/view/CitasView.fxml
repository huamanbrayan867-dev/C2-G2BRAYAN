<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.GestorOdontologico.controller.CitasController">

    <children>

        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

            <Label text="Gestión de Citas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Paciente:"/>
                <TextField fx:id="txtPaciente"/>

                <Label text="Odontólogo:"/>
                <ComboBox fx:id="cbOdontologo"/>

                <Label text="Fecha:"/>
                <DatePicker fx:id="dpFecha"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Hora:"/>
                <TextField fx:id="txtHora"/>

                <Button text="Registrar Cita" onAction="#registrarCita"/>
            </HBox>

            <TableView fx:id="tablaCitas" prefHeight="300">
                <columns>
                    <TableColumn text="ID" fx:id="colId"/>
                    <TableColumn text="Paciente" fx:id="colPaciente"/>
                    <TableColumn text="Odontólogo" fx:id="colOdontologo"/>
                    <TableColumn text="Fecha" fx:id="colFecha"/>
                    <TableColumn text="Hora" fx:id="colHora"/>
                </columns>
            </TableView>

        </VBox>

    </children>
</AnchorPane>
